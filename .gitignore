# rebuilt on every run
data/processed/
output/*

# data/bloomberg_historical/ IS committed: a one-time frozen load, documented in its README.

__pycache__/
*.pyc

# output/ is ignored above, with deliberate exceptions.  Git will not re-include a
# file whose parent directory is excluded, so each level is re-admitted in turn.
!output/runs/
output/runs/*
!output/runs/README.md
!output/runs/LATEST_CALIBRATION.txt
!output/runs/*_calibrate/
# Calibration runs are the record of which parameters were in force and when, so
# they are committed.  Pricing runs (*_price) stay ignored: regenerable, and they
# accumulate daily.

# ---------------------------------------------------------------------------
# AI-assistant tooling.  None of this belongs on the work machine: it is local
# editor configuration, it is not needed to run or understand the model, and the
# air-gapped machine has no assistant to use it.
#
# Note these were previously covered only by a GLOBAL gitignore on one machine,
# which does not travel with the repo.  Repo-level rules so a fresh clone is safe.
.claude/
.cursor/
.aider*
.continue/
.github/copilot-instructions.md
CLAUDE.md
AGENTS.md
.mcp.json

# Scratch / transcripts that occasionally land in a project directory
*.claude-transcript
.claude-*
